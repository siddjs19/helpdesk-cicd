# Copy to .env and adjust. Never commit real secrets.
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=production
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Set to 1 only when the container is served over HTTPS.
SESSION_COOKIE_SECURE=0

# Password shared by all seeded demo accounts.
DEMO_PASSWORD=helpdesk123
